# Supabase Service Role Key
# Get it from: Supabase Dashboard → Settings → API → Service Role Key
# ⚠️ NEVER commit this file - it's in .gitignore
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Realtime (for real-time database subscriptions)
# Get these from: Supabase Dashboard → Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for product-updated webhook (external callers use x-webhook-secret or body.secret)
# Same value as REVALIDATE_SECRET in Vercel is fine
# WEBHOOK_SECRET=your-secret-here

# Redis URL for distributed rate limiting (Upstash, Redis Cloud, etc.)
# For Upstash: Get Redis URL from Console → Redis Connect → Node.js tab
# Format: rediss://:PASSWORD@HOST:PORT
# REDIS_URL=rediss://:YOUR_PASSWORD@YOUR_ENDPOINT:YOUR_PORT

# Upstash REST URL (optional - for reference only, code uses REDIS_URL)
# UPSTASH_REDIS_REST_URL=https://YOUR_ENDPOINT.upstash.io

# Public WhatsApp link for footer (full URL). Example: https://wa.me/233244123456 (233 + number without leading 0)
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/233244123456

# Currency conversion (optional): ExchangeRate-API key for live GHS rates.
# Without it, the app uses the open endpoint (rate-limited) and fallback rates.
# Get a free key: https://www.exchangerate-api.com/
# EXCHANGE_RATE_API_KEY=your-api-key-here
